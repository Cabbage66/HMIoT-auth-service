# ============================================================
# Project-wide ignores for HMIoT-auth-service
# Covers Java/Spring Boot, Vue/Vite, Android/Gradle, Python models,
# Docker/LDAP certificate data, IDE files, OS files, logs, secrets,
# build outputs, and generated runtime artifacts.
# ============================================================

# ----------------------------
# OS / filesystem noise
# ----------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----------------------------
# Editor / IDE
# ----------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
*.swp
*.swo
*~

# Keep optional shared VS Code recommendations only if explicitly needed.
!.vscode/extensions.json
!frontend/.vscode/extensions.json

